# ==========================================
# SAMADHAN SETU JHARKHAND - ENVIRONMENT CONFIG
# ==========================================

# Port & Environment
ENV=development
PORT=8000

# PostgreSQL Database with PostGIS & pgvector
# Note: For Render managed Postgres, paste the External Database URL here.
# Ensure you run 'CREATE EXTENSION postgis;' and 'CREATE EXTENSION vector;' in Render psql shell.
DATABASE_URL=postgresql://postgres:samadhan_setu1234@db.recaipooboizlbtrjisb.supabase.co:5432/postgres

# Redis URL for Celery Background Tasks & Triage
# Use Render's managed Redis Internal/External URL
REDIS_URL=redis://default:your_redis_password@red-xxxxxx:6379

# Google Gemini API Key (Gemini Flash)
# When left blank, backend runs in SIMULATION MODE with visible badges
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# JWT Secret for RBAC Auth
JWT_SECRET=samadhan_setu_jharkhand_super_secret_jwt_key_2026_change_in_prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Cloudflare R2 / AWS S3 Media Storage (Optional: falls back to local uploads if omitted)
S3_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=your_s3_access_key
S3_SECRET_ACCESS_KEY=your_s3_secret_key
S3_BUCKET_NAME=samadhan-setu-media
S3_REGION_NAME=auto
S3_PUBLIC_BASE_URL=https://media.samadhansetu.jh.gov.in
